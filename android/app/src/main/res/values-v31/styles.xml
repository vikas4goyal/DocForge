<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows the system splash screen and ignores the
         windowBackground drawable for it, so brand it here: indigo
         background with the icon artwork, the same in light and dark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#4338CA</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
