#                    "android.injected.signing.key.alias" => ANDROID_SIGNING_KEY_ALIAS,
#                    "android.injected.signing.key.password" => ANDROID_SIGNING_KEY_PASSWORD,
#                }
#              )
#   end

  desc "Deploy a new version to the Google Play"
  lane :send_to_play_store do
    upload_to_play_store(
        package_name:PACKAGE_NAME,
        track:"alpha",
        json_key:GOOGLE_SERVICE_ACCOUNT_JSON_KEY_PATH,
        aab: "../build/app/outputs/bundle/release/app-release.aab",
        skip_upload_metadata:true,
        skip_upload_changelogs:true,
        skip_upload_images:true,
        skip_upload_screenshots:true,
    )
  end

  private_lane :fetch_build_number do
    sh(
      command: "cat #{BUILD_NUMBER_PATH}"
    )
  end

  private_lane :fetch_build_version do
    sh(
      command: "cat #{BUILD_VERSION_PATH}"
    )
  end
end
