<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Required by iOS before the matching system prompt can be shown. Without
	     a usage description iOS refuses the permission outright, without ever
	     asking the user, and rejects the app at review. -->
	<key>NSCameraUsageDescription</key>
	<string>DocScanly uses the camera to scan documents into PDFs.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DocScanly needs access to your photos so you can turn existing images into documents.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>DocScanly uses Face ID to unlock your documents.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DocScanly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>doc_scanly</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The app does not implement non-exempt encryption. Encryption supplied
	     by Apple platforms, such as HTTPS and Keychain protection, is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Publishes the registered iCloud Documents container as one DocScanly
	     folder in Files. The container's Documents directory is the library
	     root, so no second nested DocScanly directory is created. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.bruxkey.docscanly</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>DocScanly</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Exposes the app's Documents container in the Files app, under
	     "On My iPhone → DocScanly". This is what makes a saved PDF reachable
	     from Files and from other applications, which is the whole point of the
	     public library folder.

	     It exposes the container *wholesale*, which is why nothing private is
	     left in it: the database lives in Application Support and every derived
	     cache in Caches, so Documents holds nothing but the DocScanly folder
	     (design.md D4). -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Share-sheet and "Open in" registration. Declaring the document types
	     DocScanly accepts is what puts it in the iOS share sheet for a PDF or an
	     image. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<!-- True so files *inside our own container* can be opened in place by
	     other applications — that is what makes the DocScanly folder behave like
	     a real folder in Files rather than a read-only listing.

	     It does NOT mean DocScanly edits foreign files in place. An imported PDF
	     is still copied into the library first, because an in-place handle to
	     another app's file can be revoked and would leave a library entry
	     pointing at something we can no longer open (design.md D8). -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
