#   end
#
  private_lane :fetch_build_number do
    sh(
      command: "cat #{BUILD_NUMBER_PATH}"
    )
  end

  private_lane :fetch_build_version do
    sh(
      command: "cat #{BUILD_VERSION_PATH}"
    )
  end

  lane :update_build_number do
    buildNumber = fetch_build_number.to_i
    buildVersion = fetch_build_version
    increment_build_number({
      build_number: buildNumber,
    })
    increment_version_number({
    version_number: buildVersion
    })
    # buildNumber = fetch_build_number.to_i + 1
    # value = sh(command: "echo #{buildNumber} > #{BUILD_NUMBER_PATH}")
  end
end
